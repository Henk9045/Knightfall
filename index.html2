<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Knight's Quest</title>
<style>
html,body{
  margin:0;
  padding:0;
  background:#080a10;
  color:white;
  font-family:Arial,sans-serif;
}
body{
  display:flex;
  justify-content:center;
  padding:12px;
  box-sizing:border-box;
}
#wrap{
  width:min(1200px,100%);
  text-align:center;
}
h1{margin:5px 0 8px}
canvas{
  display:block;
  width:100%;
  height:auto;
  max-width:1200px;
  margin:auto;
  border:2px solid #555;
  image-rendering:pixelated;
  image-rendering:crisp-edges;
  touch-action:none;
}
p{
  color:#aaa;
  font-size:14px;
}
</style>
</head>
<body>
<div id="wrap">
<h1>Knight's Quest</h1>
<canvas id="gameCanvas" width="1200" height="680"></canvas>
<p>
Move: A/D or ←/→ · Jump: W/↑/Space · Attack: J/K ·
Inventory: I · Equip: 1–9 · Select an item and press DISCARD
</p>
</div>
<script>
"use strict";
/* =========================================================
   CANVAS
========================================================= */
const canvas=document.getElementById("gameCanvas");
const ctx=canvas.getContext("2d");
ctx.imageSmoothingEnabled=false;
const WIDTH=1200;
const HEIGHT=680;
const GROUND_Y=610;
/* =========================================================
   GAME STATE
========================================================= */
let currentLevel=0;
let score=0;
let coins=0;
let gameOver=false;
let victory=false;
let levelComplete=false;
let inventoryOpen=false;
let platforms=[];
let enemies=[];
let coinsList=[];
let gearDrops=[];
let boss=null;
let selectedInventory=0;
let message="";
let messageTimer=0;
/* =========================================================
   INPUT
========================================================= */
const keys={};
const pressed={};
window.addEventListener("keydown",e=>{
  const key=e.key.toLowerCase();
  if(["arrowup","arrowdown","arrowleft","arrowright"," "].includes(key)){
    e.preventDefault();
  }
  keys[key]=true;
  pressed[key]=true;
  if(key==="i"){
    inventoryOpen=!inventoryOpen;
  }
  if(inventoryOpen && /^[1-9]$/.test(e.key)){
    const slot=Number(e.key)-1;
    if(inventory[slot]){
      selectedInventory=slot;
      equipItem(slot);
    }
  }
  if(key==="enter" && levelComplete && !inventoryOpen){
    nextLevel();
  }
  if(key==="r" && !inventoryOpen && (gameOver || victory)){
    restartGame();
  }
});
window.addEventListener("keyup",e=>{
  keys[e.key.toLowerCase()]=false;
});
/* =========================================================
   PLAYER
========================================================= */
const player={
  x:70,
  y:520,
  w:45,
  h:70,
  vx:0,
  vy:0,
  speed:5,
  jump:14,
  health:100,
  maxHealth:100,
  facing:1,
  attacking:false,
  attackTimer:0,
  attackCooldown:0,
  invincibleTimer:0,
  hitTimer:0,
  onGround:false
};
/* =========================================================
   EQUIPMENT
========================================================= */
const equipment={
  weapon:{
    name:"Iron Sword",
    type:"weapon",
    damage:20,
    rarity:"common"
  },
  armor:{
    name:"Knight Armor",
    type:"armor",
    hp:0,
    rarity:"common"
  },
  boots:{
    name:"Traveler Boots",
    type:"boots",
    speed:0,
    jump:0,
    rarity:"common"
  }
};
const inventory=[
  {...equipment.weapon},
  {...equipment.armor},
  {...equipment.boots}
];
const gearPool=[
  {
    name:"Steel Sword",
    type:"weapon",
    damage:28,
    rarity:"common"
  },
  {
    name:"Flame Blade",
    type:"weapon",
    damage:38,
    rarity:"rare"
  },
  {
    name:"Shadow Greatsword",
    type:"weapon",
    damage:50,
    rarity:"epic"
  },
  {
    name:"Chainmail",
    type:"armor",
    hp:25,
    rarity:"common"
  },
  {
    name:"Knight Plate",
    type:"armor",
    hp:50,
    rarity:"rare"
  },
  {
    name:"Dragon Armor",
    type:"armor",
    hp:80,
    rarity:"epic"
  },
  {
    name:"Swift Boots",
    type:"boots",
    speed:1.2,
    jump:0,
    rarity:"common"
  },
  {
    name:"Highland Boots",
    type:"boots",
    speed:.6,
    jump:2,
    rarity:"rare"
  }
];
/* =========================================================
   LEVEL DATA
========================================================= */
const levelData=[
{
 name:"Forgotten Fields",
 bg:"#17213b",
 platforms:[
  {x:150,y:500,w:180,h:25},
  {x:430,y:430,w:190,h:25},
  {x:750,y:510,w:190,h:25},
  {x:1020,y:400,w:150,h:25}
 ],
 enemies:[
  {type:"soldier",x:360,y:545,w:45,h:65,hp:40,speed:1.5},
  {type:"soldier",x:680,y:545,w:45,h:65,hp:45,speed:1.6},
  {type:"archer",x:900,y:445,w:45,h:65,hp:55,speed:1.4}
 ],
 coins:[
  {x:220,y:455},
  {x:510,y:385},
  {x:820,y:465},
  {x:1080,y:355}
 ],
 gear:[
  {x:560,y:350,index:0}
 ]
},
{
 name:"Dark Forest",
 bg:"#10251c",
 platforms:[
  {x:110,y:520,w:170,h:25},
  {x:350,y:445,w:140,h:25},
  {x:570,y:360,w:170,h:25},
  {x:820,y:470,w:150,h:25},
  {x:1030,y:380,w:150,h:25}
 ],
 enemies:[
  {type:"soldier",x:290,y:455,w:45,h:65,hp:55,speed:1.8},
  {type:"knight",x:500,y:380,w:45,h:65,hp:65,speed:1.9},
  {type:"soldier",x:760,y:545,w:45,h:65,hp:70,speed:2},
  {type:"knight",x:980,y:315,w:45,h:65,hp:75,speed:1.9}
 ],
 coins:[
  {x:190,y:475},
  {x:420,y:400},
  {x:650,y:315},
  {x:880,y:425},
  {x:1090,y:325}
 ],
 gear:[
  {x:650,y:315,index:3},
  {x:900,y:425,index:6}
 ]
},
{
 name:"Ancient Ruins",
 bg:"#29233b",
 platforms:[
  {x:120,y:470,w:150,h:25},
  {x:330,y:350,w:140,h:25},
  {x:540,y:480,w:150,h:25},
  {x:760,y:330,w:150,h:25},
  {x:1000,y:450,w:170,h:25}
 ],
 enemies:[
  {type:"knight",x:280,y:405,w:45,h:65,hp:70,speed:2},
  {type:"knight",x:480,y:545,w:45,h:65,hp:80,speed:2.1},
  {type:"soldier",x:700,y:545,w:45,h:65,hp:85,speed:2},
  {type:"knight",x:930,y:385,w:45,h:65,hp:90,speed:2.2}
 ],
 coins:[
  {x:190,y:425},
  {x:400,y:305},
  {x:615,y:435},
  {x:835,y:285},
  {x:1080,y:405}
 ],
 gear:[
  {x:400,y:305,index:1},
  {x:835,y:285,index:7}
 ],
 boss:{
  x:1060,
  y:370,
  w:70,
  h:80,
  hp:180,
  speed:1.3,
  name:"Ruin Guardian",
  type:"guardian"
 }
},
{
 name:"Frozen Keep",
 bg:"#172b3b",
 platforms:[
  {x:100,y:520,w:160,h:25},
  {x:300,y:410,w:150,h:25},
  {x:520,y:300,w:160,h:25},
  {x:750,y:440,w:150,h:25},
  {x:970,y:330,w:180,h:25}
 ],
 enemies:[
  {type:"knight",x:270,y:345,w:45,h:65,hp:85,speed:2.1},
  {type:"knight",x:470,y:545,w:45,h:65,hp:95,speed:2.2},
  {type:"soldier",x:700,y:545,w:45,h:65,hp:100,speed:2.1},
  {type:"knight",x:920,y:265,w:45,h:65,hp:105,speed:2.3}
 ],
 coins:[
  {x:180,y:475},
  {x:375,y:365},
  {x:600,y:255},
  {x:825,y:395},
  {x:1060,y:285}
 ],
 gear:[
  {x:600,y:255,index:2},
  {x:825,y:395,index:4}
 ],
 boss:{
  x:1060,
  y:245,
  w:75,
  h:85,
  hp:250,
  speed:1.5,
  name:"Ice Warlord",
  type:"warlord"
 }
},
{
 name:"Shadow Castle",
 bg:"#160f1d",
 platforms:[
  {x:100,y:500,w:160,h:25},
  {x:310,y:390,w:140,h:25},
  {x:500,y:500,w:140,h:25},
  {x:690,y:350,w:150,h:25},
  {x:900,y:460,w:140,h:25},
  {x:1080,y:320,w:100,h:25}
 ],
 enemies:[
  {type:"knight",x:270,y:435,w:45,h:65,hp:110,speed:2.3},
  {type:"knight",x:460,y:545,w:45,h:65,hp:115,speed:2.4},
  {type:"knight",x:650,y:545,w:45,h:65,hp:120,speed:2.3},
  {type:"knight",x:850,y:395,w:45,h:65,hp:130,speed:2.5}
 ],
 coins:[
  {x:180,y:455},
  {x:380,y:345},
  {x:570,y:455},
  {x:765,y:305},
  {x:960,y:415},
  {x:1120,y:275}
 ],
 gear:[
  {x:380,y:345,index:5}
 ],
 boss:{
  x:1060,
  y:225,
  w:90,
  h:95,
  hp:400,
  speed:1.8,
  name:"Shadow King",
  type:"king"
 }
}
];
/* =========================================================
   UTILITIES
========================================================= */
function rect(a,b){
 return(
  a.x<b.x+b.w &&
  a.x+a.w>b.x &&
  a.y<b.y+b.h &&
  a.y+a.h>b.y
 );
}
function px(x,y,w,h,c){
 ctx.fillStyle=c;
 ctx.fillRect(
  Math.round(x),
  Math.round(y),
  Math.round(w),
  Math.round(h)
 );
}
function recalcStats(){
 player.maxHealth=
  100+(equipment.armor.hp||0);
 player.speed=
  5+(equipment.boots.speed||0);
 player.jump=
  14+(equipment.boots.jump||0);
 player.health=
  Math.min(player.health,player.maxHealth);
}
/* =========================================================
   INVENTORY
========================================================= */
function showMessage(t){
 message=t;
 messageTimer=100;
}
function addItem(item){
 if(inventory.length>=12){
  showMessage("Inventory is full!");
  return false;
 }
 inventory.push({...item});
 showMessage("Collected "+item.name);
 return true;
}
function equipItem(index){
 const item=inventory[index];
 if(!item)return;
 if(item.type==="weapon")
  equipment.weapon={...item};
 if(item.type==="armor")
  equipment.armor={...item};
 if(item.type==="boots")
  equipment.boots={...item};
 recalcStats();
 showMessage("Equipped "+item.name);
}
/* DISCARD SYSTEM */
function discardItem(index){
 const item=inventory[index];
 if(!item)return;
 /*
   Prevent the player from deleting their final copy
   of the three basic pieces of equipment.
 */
 const starter=[
  "Iron Sword",
  "Knight Armor",
  "Traveler Boots"
 ];
 if(starter.includes(item.name)){
  const count=
   inventory.filter(x=>x.name===item.name).length;
  if(count<=1){
   showMessage("Keep your last piece of starter gear!");
   return;
  }
 }
 /*
   If the item being discarded is currently equipped,
   automatically switch to another item of the same type
   if one exists.
 */
 let wasEquipped=false;
 if(item.type==="weapon" &&
    equipment.weapon.name===item.name){
  wasEquipped=true;
 }
 if(item.type==="armor" &&
    equipment.armor.name===item.name){
  wasEquipped=true;
 }
 if(item.type==="boots" &&
    equipment.boots.name===item.name){
  wasEquipped=true;
 }
 inventory.splice(index,1);
 if(wasEquipped){
  const replacement=
   inventory.find(x=>x.type===item.type);
  if(replacement){
   if(item.type==="weapon")
    equipment.weapon={...replacement};
   if(item.type==="armor")
    equipment.armor={...replacement};
   if(item.type==="boots")
    equipment.boots={...replacement};
   recalcStats();
  }
 }
 if(selectedInventory>=inventory.length)
  selectedInventory=
   Math.max(0,inventory.length-1);
 showMessage("Discarded "+item.name);
}
/* =========================================================
   INVENTORY MOUSE CONTROL
========================================================= */
canvas.addEventListener("click",e=>{
 if(!inventoryOpen)return;
 const r=canvas.getBoundingClientRect();
 const x=
  (e.clientX-r.left)*WIDTH/r.width;
 const y=
  (e.clientY-r.top)*HEIGHT/r.height;
 /* Item slots */
 const sx0=280;
 const sy0=145;
 const slotW=120;
 const slotH=72;
 for(let i=0;i<12;i++){
  const col=i%4;
  const row=Math.floor(i/4);
  const sx=sx0+col*slotW;
  const sy=sy0+row*slotH;
  if(
   x>=sx &&
   x<=sx+108 &&
   y>=sy &&
   y<=sy+62
  ){
   selectedInventory=i;
   return;
  }
 }
 /* DISCARD BUTTON */
 if(
  x>=475 &&
  x<=725 &&
  y>=590 &&
  y<=635
 ){
  discardItem(selectedInventory);
 }
});
/* =========================================================
   LEVEL SETUP
========================================================= */
function setupLevel(index){
 currentLevel=index;
 const data=levelData[index];
 platforms=data.platforms.map(p=>({...p}));
 enemies=data.enemies.map(e=>({
  ...e,
  maxHp:e.hp,
  direction:-1,
  state:"patrol",
  patrolMin:e.x-90,
  patrolMax:e.x+90,
  stepTimer:Math.random()*10,
  attackCooldown:
   15+Math.random()*15,
  attackWindup:0,
  attackHit:false,
  hurtTimer:0,
  alertTimer:0,
  rushSpeed:e.speed+1.0
 }));
 coinsList=data.coins.map(c=>({
  ...c,
  collected:false
 }));
 gearDrops=data.gear.map(g=>({
  ...g,
  collected:false,
  item:{...gearPool[g.index]}
 }));
 boss=data.boss
  ? {
    ...data.boss,
    maxHp:data.boss.hp,
    direction:-1,
    attackTimer:0,
    attackWindup:0,
    attackHit:false,
    hurtTimer:0,
    stepTimer:0
   }
  : null;
 player.x=70;
 player.y=520;
 player.vx=0;
 player.vy=0;
 player.health=player.maxHealth;
 player.invincibleTimer=40;
 levelComplete=false;
 inventoryOpen=false;
}
/* =========================================================
   PLAYER DAMAGE
========================================================= */
function damagePlayer(amount,sourceX){
 if(player.invincibleTimer>0)return;
 player.health-=amount;
 player.invincibleTimer=45;
 player.hitTimer=12;
 player.vx=
  player.x<sourceX ? -5 : 5;
 player.vy=-4;
 if(player.health<=0){
  player.health=0;
  gameOver=true;
 }
}
/* =========================================================
   PLAYER UPDATE
========================================================= */
function updatePlayer(){
 if(gameOver||victory||levelComplete)
  return;
 const left=
  keys["a"]||keys["arrowleft"];
 const right=
  keys["d"]||keys["arrowright"];
 player.vx=0;
 if(left){
  player.vx=-player.speed;
  player.facing=-1;
 }
 if(right){
  player.vx=player.speed;
  player.facing=1;
 }
 /* Jump */
 if(
  (pressed["w"]||
   pressed["arrowup"]||
   pressed[" "]) &&
  player.onGround
 ){
  player.vy=-player.jump;
  player.onGround=false;
 }
 /* Attack */
 if(
  (pressed["j"]||pressed["k"]) &&
  player.attackCooldown<=0
 ){
  player.attacking=true;
  player.attackTimer=13;
  player.attackCooldown=20;
 }
 if(player.attackTimer>0){
  player.attackTimer--;
  if(player.attackTimer===7)
   playerAttack();
  if(player.attackTimer===0)
   player.attacking=false;
 }
 if(player.attackCooldown>0)
  player.attackCooldown--;
 if(player.invincibleTimer>0)
  player.invincibleTimer--;
 if(player.hitTimer>0)
  player.hitTimer--;
 /* Gravity */
 player.vy+=.7;
 player.x+=player.vx;
 player.y+=player.vy;
 if(player.x<0)
  player.x=0;
 if(player.x+player.w>WIDTH)
  player.x=WIDTH-player.w;
 player.onGround=false;
 /* Ground */
 if(player.y+player.h>=GROUND_Y){
  player.y=GROUND_Y-player.h;
  player.vy=0;
  player.onGround=true;
 }
 /* Platforms */
 for(const p of platforms){
  if(
   player.vy>=0 &&
   player.x+player.w>p.x &&
   player.x<p.x+p.w &&
   player.y+player.h>=p.y &&
   player.y+player.h<=p.y+18
  ){
   player.y=p.y-player.h;
   player.vy=0;
   player.onGround=true;
  }
 }
 checkLevelExit();
}
/* =========================================================
   PLAYER ATTACK
========================================================= */
function playerAttack(){
 const box={
  x:
   player.facing===1
    ?player.x+player.w-2
    :player.x-55,
  y:player.y+18,
  w:58,
  h:38
 };
 for(const e of enemies){
  if(e.hp>0 && rect(box,e)){
   e.hp-=equipment.weapon.damage;
   e.hurtTimer=8;
   e.x+=player.facing*14;
   score+=10;
   if(e.hp<=0){
    score+=25;
    /*
      Chance for defeated enemies to drop
      a random item.
    */
    if(Math.random()<.28){
     const item=
      gearPool[
       Math.floor(Math.random()*gearPool.length)
      ];
     gearDrops.push({
      x:e.x+20,
      y:e.y+10,
      collected:false,
      item:{...item}
     });
    }
   }
  }
 }
 if(
  boss &&
  boss.hp>0 &&
  rect(box,boss)
 ){
  boss.hp-=equipment.weapon.damage;
  boss.hurtTimer=8;
  boss.x+=player.facing*10;
  score+=30;
 }
}
/* =========================================================
   ENEMY ATTACK
========================================================= */
function startEnemyAttack(e){
 if(
  e.attackCooldown<=0 &&
  e.attackWindup<=0
 ){
  e.attackWindup=12;
  e.attackHit=false;
  e.attackCooldown=
   22+Math.random()*12;
  e.state="attack";
 }
}
function updateEnemyAttack(e){
 if(e.attackCooldown>0)
  e.attackCooldown--;
 if(e.attackWindup>0){
  e.attackWindup--;
  /*
    The attack actually deals damage
    on exactly one active frame.
  */
  if(
   e.attackWindup===4 &&
   !e.attackHit
  ){
   const box={
    x:
     e.direction===1
      ?e.x+e.w-4
      :e.x-50,
    y:e.y+17,
    w:55,
    h:40
   };
   if(rect(box,player))
    damagePlayer(
     9+currentLevel*2,
     e.x
    );
   e.attackHit=true;
  }
  if(e.attackWindup===0)
   e.state="rush";
 }
}
/* =========================================================
   AGGRESSIVE RUSH AI
========================================================= */
function updateEnemies(){
 for(const e of enemies){
  if(e.hp<=0)
   continue;
  if(e.hurtTimer>0){
   e.hurtTimer--;
   continue;
  }
  updateEnemyAttack(e);
  const dx=player.x-e.x;
  const dy=player.y-e.y;
  const distanceX=Math.abs(dx);
  const distanceY=Math.abs(dy);
  /*
    Close enough to attack.
  */
  if(
   e.attackWindup<=0 &&
   distanceX<112 &&
   distanceY<85
  ){
   e.direction=
    dx>=0 ? 1 : -1;
   startEnemyAttack(e);
  }
  /*
    RUSH MODE
    Enemies detect the player from 520 pixels away
    and aggressively run toward them.
  */
  if(e.attackWindup<=0){
   if(
    distanceX<520 &&
    distanceY<220
   ){
    if(e.state!=="rush")
     e.alertTimer=20;
    e.state="rush";
    e.direction=
     dx>=0 ? 1 : -1;
    /*
      Keep moving toward the player.
      This is faster than normal patrol speed.
    */
    const speed=
     distanceX<85
      ?e.rushSpeed*.35
      :e.rushSpeed;
    e.x+=e.direction*speed;
    /*
      Fast step animation.
    */
    e.stepTimer+=.32;
   }else{
    /*
      Normal patrol when the player
      is too far away.
    */
    e.state="patrol";
    if(e.x<=e.patrolMin)
     e.direction=1;
    if(e.x>=e.patrolMax)
     e.direction=-1;
    e.x+=e.direction*e.speed;
    e.stepTimer+=.2;
   }
  }
  e.x=
   Math.max(
    5,
    Math.min(WIDTH-e.w-5,e.x)
   );
  if(e.alertTimer>0)
   e.alertTimer--;
 }
}
/* =========================================================
   BOSS
========================================================= */
function updateBoss(){
 if(
  !boss||
  boss.hp<=0||
  levelComplete
 )
  return;
 if(boss.hurtTimer>0){
  boss.hurtTimer--;
  return;
 }
 boss.attackTimer++;
 const dx=player.x-boss.x;
 const dy=player.y-boss.y;
 boss.direction=
  dx>=0?1:-1;
 if(boss.attackWindup>0){
  boss.attackWindup--;
  if(
   boss.attackWindup===5 &&
   !boss.attackHit
  ){
   const box={
    x:
     boss.direction===1
      ?boss.x+boss.w-8
      :boss.x-70,
    y:boss.y+20,
    w:75,
    h:45
   };
   if(rect(box,player))
    damagePlayer(
     18+currentLevel*3,
     boss.x
    );
   boss.attackHit=true;
  }
  if(boss.attackWindup===0)
   boss.attackTimer=0;
 }else{
  if(
   Math.abs(dx)<135 &&
   Math.abs(dy)<100 &&
   boss.attackTimer>30
  ){
   boss.attackWindup=16;
   boss.attackHit=false;
  }else{
   boss.x+=
    boss.direction*boss.speed;
  }
 }
}
/* =========================================================
   COINS / GEAR
========================================================= */
function updateCoins(){
 for(const c of coinsList){
  if(
   !c.collected &&
   Math.hypot(
    player.x+22-c.x,
    player.y+30-c.y
   )<32
  ){
   c.collected=true;
   coins++;
   score+=5;
  }
 }
}
function updateGear(){
 for(const g of gearDrops){
  if(
   !g.collected &&
   Math.hypot(
    player.x+22-g.x,
    player.y+30-g.y
   )<35
  ){
   if(addItem(g.item))
    g.collected=true;
  }
 }
}
/* =========================================================
   LEVEL PROGRESSION
========================================================= */
function allEnemiesDefeated(){
 return(
  enemies.every(e=>e.hp<=0) &&
  (!boss||boss.hp<=0)
 );
}
function checkLevelExit(){
 if(
  allEnemiesDefeated() &&
  player.x>WIDTH-100
 ){
  levelComplete=true;
 }
}
function nextLevel(){
 if(currentLevel<levelData.length-1){
  setupLevel(currentLevel+1);
 }else{
  victory=true;
 }
}
/* =========================================================
   DRAW BACKGROUND
========================================================= */
function drawBackground(){
 ctx.fillStyle=
  levelData[currentLevel].bg;
 ctx.fillRect(
  0,0,WIDTH,HEIGHT
 );
 /* distant pixel clouds */
 for(let i=0;i<8;i++){
  const x=
   (i*190+currentLevel*40)%WIDTH;
  const y=
   90+(i%3)*45;
  px(
   x,y,
   80,7,
   "rgba(255,255,255,.04)"
  );
  px(
   x+20,y-7,
   40,7,
   "rgba(255,255,255,.04)"
  );
 }
 /* ground */
 px(
  0,
  GROUND_Y,
  WIDTH,
  HEIGHT-GROUND_Y,
  "#252a31"
 );
 for(let x=0;x<WIDTH;x+=32){
  px(
   x,
   GROUND_Y,
   20,
   5,
   "#454b52"
  );
 }
}
/* =========================================================
   PLATFORMS
========================================================= */
function drawPlatforms(){
 for(const p of platforms){
  px(
   p.x,p.y,
   p.w,p.h,
   "#454b56"
  );
  px(
   p.x,p.y,
   p.w,5,
   "#a5adb5"
  );
  px(
   p.x+8,
   p.y+8,
   p.w-16,
   5,
   "#343941"
  );
  for(
   let x=p.x+12;
   x<p.x+p.w-8;
   x+=28
  ){
   px(
    x,p.y+15,
    14,5,
    "#252a30"
   );
  }
 }
}
/* =========================================================
   COINS
========================================================= */
function drawCoins(){
 for(const c of coinsList){
  if(c.collected)
   continue;
  const bob=
   Math.sin(
    performance.now()/180+c.x
   )*4;
  px(
   c.x-7,
   c.y-12+bob,
   14,24,
   "#c99020"
  );
  px(
   c.x-4,
   c.y-15+bob,
   8,30,
   "#f2c94c"
  );
  px(
   c.x-1,
   c.y-10+bob,
   4,20,
   "#fff0a0"
  );
 }
}
/* =========================================================
   GEAR DROPS
========================================================= */
function drawGear(){
 for(const g of gearDrops){
  if(g.collected)
   continue;
  const bob=
   Math.sin(
    performance.now()/200+g.x
   )*4;
  px(
   g.x-10,
   g.y-10+bob,
   20,20,
   "#b48a36"
  );
  px(
   g.x-6,
   g.y-14+bob,
   12,28,
   "#d9b84c"
  );
  px(
   g.x-3,
   g.y-17+bob,
   6,34,
   "#f3df85"
  );
 }
}
/* =========================================================
   DETAILED PIXEL ENEMIES
========================================================= */
const palettes={
 soldier:{
  helmet:"#737d86",
  helmetDark:"#394149",
  visor:"#11151a",
  eye:"#ff5555",
  armor:"#7d8992",
  armorDark:"#46525b",
  armorLight:"#c0c8cd",
  cape:"#852a35",
  capeDark:"#43151c",
  belt:"#302018",
  boot:"#24292e",
  metal:"#e0e6e9",
  crest:"#c09a3b"
 },
 knight:{
  helmet:"#56636f",
  helmetDark:"#222b34",
  visor:"#0b0e12",
  eye:"#7fe6ff",
  armor:"#435969",
  armorDark:"#25343f",
  armorLight:"#a9b7c0",
  cape:"#243d6c",
  capeDark:"#101c34",
  belt:"#171b20",
  boot:"#161b20",
  metal:"#e0e8ec",
  crest:"#d3ad3b"
 },
 archer:{
  helmet:"#455c4d",
  helmetDark:"#26362d",
  visor:"#111813",
  eye:"#d6ff8b",
  armor:"#5d704f",
  armorDark:"#344430",
  armorLight:"#a0b17d",
  cape:"#294731",
  capeDark:"#17291d",
  belt:"#382619",
  boot:"#30271f",
  metal:"#cbd6c8",
  crest:"#a9c36c"
 }
};
/*
  15 x 22 pixel sprite.
  Every character becomes a 3x3 pixel block,
  producing a 45x66 pixel character.
  This gives the enemies much more pixel detail
  than the original large-block models.
*/
const enemySprite=[
 ".....CCCCC.....",
 "....CCCCCCC....",
 "...KKKKKKKKK...",
 "..KKKKKKKKKKK..",
 "..KKKMMMMKKKK..",
 "..KKVVEVVEKKK..",
 "..KKVVVVVKKKK..",
 "...KAAAAAK.....",
 "..PAAAAAAAP....",
 ".PPAAAAAAAPP...",
 ".PAAATTTAAAP...",
 "..AATTTTAA.....",
 "..GGAAAAAGG....",
 "..GGAAAAAGG....",
 "...GGGGGGG.....",
 "...BB...BB.....",
 "..BBBB.BBBB....",
 "..BBBB.BBBB....",
 "..BB...BBB.....",
 "..BBBBBBBBB....",
 "...............",
 "..............."
];
function drawPixelEnemy(e){
 const p=
  palettes[e.type]||
  palettes.soldier;
 const x=Math.round(e.x);
 const y=Math.round(e.y);
 const bob=
  e.state==="rush"
   ?Math.round(Math.sin(e.stepTimer)*1.5)
   :0;
 /* shadow */
 px(
  x+4,
  y+62,
  37,5,
  "rgba(0,0,0,.4)"
 );
 /*
   Cape is drawn behind the actual body.
 */
 px(
  x+8,
  y+15+bob,
  13,32,
  p.capeDark
 );
 px(
  x+5,
  y+21+bob,
  7,25,
  p.cape
 );
 px(
  x+20,
  y+18+bob,
  7,31,
  p.cape
 );
 px(
  x+3,
  y+30+bob,
  5,12,
  p.capeDark
 );
 /*
   Mirror the sprite depending on facing.
 */
 ctx.save();
 ctx.imageSmoothingEnabled=false;
 if(e.direction===-1){
  ctx.translate(x+45,y+bob);
  ctx.scale(-1,1);
 }else{
  ctx.translate(x,y+bob);
 }
 const cell=3;
 for(
  let row=0;
  row<enemySprite.length;
  row++
 ){
  for(
   let col=0;
   col<enemySprite[row].length;
   col++
  ){
   const ch=
    enemySprite[row][col];
   let color=null;
   if(ch==="C")color=p.cape;
   if(ch==="K")color=p.helmet;
   if(ch==="M")color=p.metal;
   if(ch==="V")color=p.visor;
   if(ch==="E")color=p.eye;
   if(ch==="A")color=p.armor;
   if(ch==="P")color=p.armorLight;
   if(ch==="T")color=p.belt;
   if(ch==="G")color=p.armorDark;
   if(ch==="B")color=p.boot;
   if(color){
    px(
     col*cell,
     row*cell,
     cell,cell,
     color
    );
   }
  }
 }
 /*
   Tiny highlights make the armor
   look less flat.
 */
 px(12,27,3,3,p.armorLight);
 px(30,30,3,3,p.armorDark);
 px(15,36,3,3,p.metal);
 px(24,36,3,3,p.armorDark);
 /*
   Running legs.
   These extra pixels change position while
   rushing toward the player.
 */
 if(
  e.state==="rush" &&
  e.attackWindup<=0
 ){
  const step=
   Math.sin(e.stepTimer)>0;
  if(step){
   px(6,51,9,3,p.boot);
   px(30,48,9,3,p.boot);
  }else{
   px(9,48,9,3,p.boot);
   px(27,51,9,3,p.boot);
  }
 }
 /*
   Helmet crest.
 */
 px(
  15,0,
  12,3,
  p.crest
 );
 px(
  18,3,
  9,3,
  p.crest
 );
 /*
   Weapon.
   It swings upward/downward during the
   enemy attack wind-up.
 */
 if(e.attackWindup<=0){
  px(
   39,27,
   3,18,
   p.belt
  );
  px(
   36,30,
   9,3,
   p.crest
  );
  px(
   42,9,
   3,21,
   p.metal
  );
  px(
   45,6,
   3,6,
   p.metal
  );
  px(
   45,9,
   3,3,
   "#ffffff"
  );
 }else{
  const progress=
   1-e.attackWindup/12;
  const sy=
   43-
   Math.sin(progress*Math.PI)*27;
  px(
   33,28,
   3,12,
   p.belt
  );
  px(
   30,30,
   9,3,
   p.crest
  );
  px(
   36,sy,
   3,30,
   p.metal
  );
  px(
   39,sy-3,
   3,6,
   p.metal
  );
  px(
   36,sy+3,
   3,3,
   "#ffffff"
  );
 }
 /*
   Archer gets a visible bow.
 */
 if(e.type==="archer"){
  px(39,20,3,27,p.crest);
  px(42,17,3,33,p.crest);
  px(45,20,3,27,p.crest);
 }
 ctx.restore();
 /*
   Rush indicator.
   A yellow ! appears when an enemy
   notices the player.
 */
 if(e.alertTimer>0){
  px(
   x+18,
   y-18,
   10,10,
   "#f1d26a"
  );
  px(
   x+21,
   y-15,
   4,7,
   "#201b12"
  );
 }
 /* Enemy health bar */
 px(
  x,
  y-8,
  45,5,
  "#151515"
 );
 px(
  x+1,
  y-7,
  43*Math.max(
   0,
   e.hp/e.maxHp
  ),
  3,
  "#5ed06a"
 );
}
/* =========================================================
   PLAYER PIXEL ART
========================================================= */
function drawPlayer(){
 const x=Math.round(player.x);
 const y=Math.round(player.y);
 if(
  player.invincibleTimer>0 &&
  Math.floor(
   player.invincibleTimer/4
  )%2===0
 )
  return;
 /* shadow */
 px(
  x+4,y+66,
  37,4,
  "rgba(0,0,0,.4)"
 );
 /* cape */
 px(x+7,y+17,12,38,"#a32836");
 px(x+3,y+29,7,22,"#681b27");
 px(x+16,y+23,7,31,"#7e202c");
 /* legs */
 px(x+10,y+49,10,17,"#303b48");
 px(x+27,y+49,10,17,"#303b48");
 px(x+7,y+63,14,6,"#171b20");
 px(x+26,y+63,14,6,"#171b20");
 /* armor */
 px(x+9,y+23,28,29,"#65727e");
 px(x+13,y+26,20,23,"#9ba7b0");
 px(x+16,y+27,14,5,"#cbd2d6");
 px(x+20,y+33,6,13,"#56626d");
 px(x+9,y+45,28,5,"#22282f");
 /* shoulder armor */
 px(x+7,y+44,6,8,"#8c9aa5");
 px(x+32,y+44,7,8,"#8c9aa5");
 /* arms */
 px(x+3,y+28,7,22,"#505c67");
 px(x+35,y+28,7,22,"#505c67");
 px(x+1,y+45,10,8,"#c0c9ce");
 px(x+34,y+45,10,8,"#c0c9ce");
 /* helmet */
 px(x+9,y+4,29,24,"#59656f");
 px(x+13,y+1,21,5,"#7f8a92");
 px(x+7,y+10,35,15,"#707c85");
 /* visor */
 px(x+10,y+15,30,8,"#15191e");
 /* visor openings */
 px(x+14,y+17,5,3,"#d9e4e8");
 px(x+23,y+17,5,3,"#d9e4e8");
 px(x+32,y+17,5,3,"#d9e4e8");
 px(x+20,y+21,9,3,"#2b3137");
 /* crest */
 px(x+17,y,9,3,"#d0a63d");
 /* sword */
 if(player.attacking){
  const t=
   1-player.attackTimer/13;
  const sy=
   y+48-
   Math.sin(t*Math.PI)*34;
  const sx=
   player.facing>0
    ?x+38
    :x-5;
  px(
   sx,sy,
   4,34,
   "#e6edf0"
  );
  px(
   sx+(player.facing>0?4:-1),
   sy+5,
   3,22,
   "#ffffff"
  );
  px(
   x+(player.facing>0?34:0),
   y+34,
   10,4,
   "#d0a63d"
  );
 }else{
  const sx=
   player.facing>0
    ?x+39
    :x-4;
  px(
   sx,y+32,
   4,27,
   "#e1e8eb"
  );
  px(
   sx+(player.facing>0?-3:3),
   y+53,
   10,4,
   "#d0a63d"
  );
 }
}
/* =========================================================
   BOSSES
========================================================= */
function drawBoss(){
 if(!boss||boss.hp<=0)
  return;
 const x=Math.round(boss.x);
 const y=Math.round(boss.y);
 let main=
  boss.type==="king"
   ?"#55336f"
   :boss.type==="warlord"
    ?"#3e6d83"
    :"#60486f";
 /* cape */
 px(
  x+5,y+14,
  boss.w-10,
  boss.h-15,
  "#261d35"
 );
 px(
  x+10,y+18,
  12,boss.h-25,
  main
 );
 /* armor */
 px(
  x+8,y+8,
  boss.w-16,
  boss.h-10,
  main
 );
 px(
  x+14,y+20,
  boss.w-28,
  38,
  "#69737c"
 );
 px(
  x+9,y+15,
  boss.w-18,
  8,
  "#aab2b7"
 );
 /* visor */
 px(
  x+15,y+27,
  boss.w-30,
  8,
  "#101318"
 );
 px(
  x+22,y+29,
  7,4,
  "#ff5252"
 );
 px(
  x+boss.w-29,
  y+29,
  7,4,
  "#ff5252"
 );
 /* helmet */
 px(
  x+18,y+2,
  boss.w-36,
  15,
  "#3b4148"
 );
 /* body */
 px(
  x+10,y+48,
  boss.w-20,
  10,
  "#272d34"
 );
 /* legs */
 px(
  x+12,y+58,
  16,20,
  "#252a30"
 );
 px(
  x+boss.w-28,y+58,
  16,20,
  "#252a30"
 );
 /* shoulder armor */
 px(x+4,y+20,12,24,main);
 px(x+boss.w-16,y+20,12,24,main);
 /* Shadow King crown */
 if(boss.type==="king"){
  px(
   x+18,y-5,
   boss.w-36,7,
   "#c9a62e"
  );
  for(let i=0;i<4;i++){
   px(
    x+18+i*15,
    y-12-(i%2)*4,
    7,9,
    "#e4c54b"
   );
  }
 }
 /* weapon */
 if(boss.attackWindup>0){
  px(
   boss.direction>0
    ?x+boss.w-5
    :x-55,
   y+25,
   6,52,
   "#e2e7ea"
  );
  px(
   boss.direction>0
    ?x+boss.w-12
    :x+boss.w+2,
   y+38,
   16,6,
   "#c9a62e"
  );
 }else{
  const sx=
   boss.direction>0
    ?x+boss.w-5
    :x-10;
  px(
   sx,y+25,
   6,52,
   "#e2e7ea"
  );
  px(
   sx+(boss.direction>0?-9:3),
   y+38,
   16,6,
   "#c9a62e"
  );
 }
 /* boss health bar */
 px(
  x,
  y-12,
  boss.w,
  7,
  "#171717"
 );
 px(
  x+2,
  y-11,
  (boss.w-4)*
   Math.max(
    0,
    boss.hp/boss.maxHp
   ),
  5,
  "#d45a61"
 );
 ctx.fillStyle="#fff";
 ctx.font="12px Arial";
 ctx.textAlign="center";
 ctx.fillText(
  boss.name,
  x+boss.w/2,
  y-18
 );
 ctx.textAlign="left";
}
/* =========================================================
   UI
========================================================= */
function drawUI(){
 /* player health */
 px(
  18,18,
  250,18,
  "#16191e"
 );
 px(
  20,20,
  246*
   Math.max(
    0,
    player.health/player.maxHealth
   ),
  14,
  "#58c86b"
 );
 ctx.fillStyle="#fff";
 ctx.font="16px Arial";
 ctx.fillText(
  `HP ${player.health}/${player.maxHealth}`,
  28,34
 );
 ctx.fillText(
  `Coins: ${coins}   Score: ${score}`,
  20,60
 );
 ctx.fillText(
  `Level ${currentLevel+1}/5: ${levelData[currentLevel].name}`,
  20,84
 );
 ctx.font="14px Arial";
 ctx.fillText(
  `Weapon: ${equipment.weapon.name}`,
  900,28
 );
 ctx.fillText(
  `Armor: ${equipment.armor.name}`,
  900,48
 );
 ctx.fillText(
  `Boots: ${equipment.boots.name}`,
  900,68
 );
 if(messageTimer>0){
  px(
   400,92,
   400,34,
   "rgba(0,0,0,.8)"
  );
  ctx.fillStyle="#fff";
  ctx.textAlign="center";
  ctx.fillText(
   message,
   600,114
  );
  ctx.textAlign="left";
 }
}
/* =========================================================
   INVENTORY SCREEN
========================================================= */
function drawInventory(){
 /* dark overlay */
 px(
  130,70,
  940,570,
  "rgba(8,10,15,.97)"
 );
 ctx.strokeStyle="#9ca6b0";
 ctx.lineWidth=3;
 ctx.strokeRect(
  130,70,
  940,570
 );
 ctx.fillStyle="#fff";
 ctx.font="28px Arial";
 ctx.fillText(
  "INVENTORY",
  170,112
 );
 ctx.font="15px Arial";
 ctx.fillText(
  "Click an item to select it. Number keys 1–9 equip it.",
  170,135
 );
 ctx.fillText(
  "Use DISCARD SELECTED to remove the selected item.",
  170,155
 );
 const startX=280;
 const startY=170;
 const slotW=120;
 const slotH=72;
 for(let i=0;i<12;i++){
  const col=i%4;
  const row=Math.floor(i/4);
  const x=startX+col*slotW;
  const y=startY+row*slotH;
  const selected=
   i===selectedInventory;
  px(
   x,y,
   108,62,
   selected
    ?"#596879"
    :"#252b33"
  );
  ctx.strokeStyle=
   selected
    ?"#f1d26a"
    :"#505963";
  ctx.strokeRect(
   x,y,108,62
  );
  ctx.fillStyle="#fff";
  ctx.font="13px Arial";
  ctx.fillText(
   `${i+1}`,
   x+7,y+16
  );
  if(inventory[i]){
   ctx.fillText(
    inventory[i].name,
    x+25,y+18
   );
   ctx.fillStyle="#b9c0c6";
   let stat="";
   if(inventory[i].type==="weapon")
    stat=`Damage ${inventory[i].damage}`;
   if(inventory[i].type==="armor")
    stat=`+${inventory[i].hp} Max HP`;
   if(inventory[i].type==="boots")
    stat=
     `Speed +${inventory[i].speed} Jump +${inventory[i].jump}`;
   ctx.fillText(
    stat,
    x+25,y+39
   );
   ctx.fillStyle=
    inventory[i].rarity==="epic"
     ?" #d7a8ff"
     :inventory[i].rarity==="rare"
      ?" #77c8ff"
      :"#d7d7d7";
   /* Fix possible leading space */
   ctx.fillStyle=
    inventory[i].rarity==="epic"
     ?"#d7a8ff"
     :inventory[i].rarity==="rare"
      ?"#77c8ff"
      :"#d7d7d7";
   ctx.fillText(
    inventory[i].rarity.toUpperCase(),
    x+25,y+55
   );
  }else{
   ctx.fillStyle="#777";
   ctx.fillText(
    "Empty",
    x+25,y+35
   );
  }
 }
 /* Equipped panel */
 px(
  175,485,
  250,105,
  "#20262d"
 );
 ctx.fillStyle="#fff";
 ctx.font="16px Arial";
 ctx.fillText(
  "EQUIPPED",
  190,510
 );
 ctx.font="13px Arial";
 ctx.fillText(
  equipment.weapon.name,
  190,532
 );
 ctx.fillText(
  equipment.armor.name,
  190,551
 );
 ctx.fillText(
  equipment.boots.name,
  190,570
 );
 /* Discard button */
 px(
  475,590,
  250,45,
  "#7c3038"
 );
 ctx.fillStyle="#fff";
 ctx.font="20px Arial";
 ctx.textAlign="center";
 ctx.fillText(
  "DISCARD SELECTED",
  600,619
 );
 ctx.textAlign="left";
 /* Help */
 ctx.fillStyle="#aaa";
 ctx.font="13px Arial";
 ctx.fillText(
  "You can discard extra gear. Your final starter gear cannot be discarded.",
  750,510
 );
}
/* =========================================================
   LEVEL COMPLETE
========================================================= */
function drawLevelComplete(){
 px(
  300,225,
  600,220,
  "rgba(0,0,0,.92)"
 );
 ctx.strokeStyle="#d5b84a";
 ctx.lineWidth=4;
 ctx.strokeRect(
  300,225,
  600,220
 );
 ctx.fillStyle="#fff";
 ctx.textAlign="center";
 ctx.font="34px Arial";
 ctx.fillText(
  "LEVEL COMPLETE!",
  600,275
 );
 ctx.font="18px Arial";
 ctx.fillText(
  "All enemies have been defeated.",
  600,315
 );
 ctx.fillText(
  currentLevel<4
   ?"Press ENTER for the next level"
   :"Press ENTER to finish the game",
  600,365
 );
 ctx.textAlign="left";
}
/* =========================================================
   GAME OVER
========================================================= */
function drawGameOver(){
 px(
  300,240,
  600,180,
  "rgba(0,0,0,.94)"
 );
 ctx.fillStyle="#e35b64";
 ctx.textAlign="center";
 ctx.font="42px Arial";
 ctx.fillText(
  "YOU DIED",
  600,300
 );
 ctx.fillStyle="#fff";
 ctx.font="20px Arial";
 ctx.fillText(
  "Press R to restart the level",
  600,350
 );
 ctx.textAlign="left";
}
/* =========================================================
   VICTORY
========================================================= */
function drawVictory(){
 px(
  250,210,
  700,250,
  "rgba(0,0,0,.95)"
 );
 ctx.fillStyle="#f1d26a";
 ctx.textAlign="center";
 ctx.font="42px Arial";
 ctx.fillText(
  "VICTORY!",
  600,280
 );
 ctx.fillStyle="#fff";
 ctx.font="20px Arial";
 ctx.fillText(
  "The Shadow King has fallen.",
  600,325
 );
 ctx.fillText(
  `Final score: ${score}   Coins: ${coins}`,
  600,360
 );
 ctx.fillText(
  "Press R to play again",
  600,405
 );
 ctx.textAlign="left";
}
/* =========================================================
   UPDATE
========================================================= */
function update(){
 if(
  !inventoryOpen &&
  !gameOver &&
  !victory &&
  !levelComplete
 ){
  updatePlayer();
  updateEnemies();
  updateBoss();
  updateCoins();
  updateGear();
 }
 if(messageTimer>0)
  messageTimer--;
 for(const k in pressed)
  delete pressed[k];
}
/* =========================================================
   DRAW
========================================================= */
function draw(){
 ctx.clearRect(
  0,0,
  WIDTH,HEIGHT
 );
 drawBackground();
 drawPlatforms();
 drawCoins();
 drawGear();
 for(const e of enemies)
  drawPixelEnemy(e);
 drawBoss();
 drawPlayer();
 drawUI();
 if(inventoryOpen)
  drawInventory();
 if(
  levelComplete &&
  !inventoryOpen
 )
  drawLevelComplete();
 if(gameOver)
  drawGameOver();
 if(victory)
  drawVictory();
}
/* =========================================================
   RESTART
========================================================= */
function restartGame(){
 if(victory){
  score=0;
  coins=0;
  inventory.length=0;
  inventory.push(
   {
    name:"Iron Sword",
    type:"weapon",
    damage:20,
    rarity:"common"
   },
   {
    name:"Knight Armor",
    type:"armor",
    hp:0,
    rarity:"common"
   },
   {
    name:"Traveler Boots",
    type:"boots",
    speed:0,
    jump:0,
    rarity:"common"
   }
  );
  equipment.weapon={...inventory[0]};
  equipment.armor={...inventory[1]};
  equipment.boots={...inventory[2]};
  recalcStats();
  victory=false;
  setupLevel(0);
 }else{
  gameOver=false;
  setupLevel(currentLevel);
 }
}
/* =========================================================
   START
========================================================= */
recalcStats();
setupLevel(0);
function gameLoop(){
 update();
 draw();
 requestAnimationFrame(gameLoop);
}
gameLoop();
</script>
</body>
</html>
