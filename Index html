<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <!-- Makes the game work well on phones, tablets, and computers -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Knight's Quest</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #111;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        header {
            padding: 20px;
            background: #1b1b1b;
            border-bottom: 2px solid #444;
        }

        h1 {
            margin: 0;
            font-size: 32px;
        }

        p {
            color: #bbb;
        }

        #game-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        canvas {
            width: 100%;
            max-width: 1280px;
            height: auto;
            background: #222;
            border: 3px solid #555;
            image-rendering: pixelated;
        }

        #loading {
            padding: 30px;
            font-size: 20px;
        }
    </style>
</head>

<body>

    <header>
        <h1>⚔️ Knight's Quest ⚔️</h1>
        <p>Collect gear. Become stronger. Defeat the final boss.</p>
    </header>

    <div id="loading">
        Loading game...
    </div>

    <div id="game-container">
        <canvas id="gameCanvas" width="1280" height="720"></canvas>
    </div>

    <!-- Your game code -->
    <script src="game.js"></script>

    <script>
        // Hide the loading message once the page has loaded
        window.addEventListener("load", function () {
            document.getElementById("loading").style.display = "none";
        });
    </script>

</body>
</html>
